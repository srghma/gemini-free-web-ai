{
  "manifest_version": 3,
  "name": "Gemini Free Web AI Controller",
  "version": "1.3.0",
  "description": "Bridge Google AI Studio directly to local execution daemon",
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://aistudio.google.com/*"
      ],
      "js": ["src/content.ts"],
      "run_at": "document_end"
    }
  ]
}
