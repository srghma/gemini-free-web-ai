import asyncio
import json
import time
from typing import Dict, List, Optional
import httpx
from rich.markdown import Markdown as RichMarkdown
from textual import on, work
from textual.app import App, ComposeResult
from textual.containers import Container, Horizontal, Vertical, VerticalScroll
from textual.reactive import reactive
from textual.widgets import (
    Button,
    Footer,
    Header,
    Input,
    Label,
    OptionList,
    Select,
    Static,
    TextArea,
)
from textual.widgets.option_list import Option

DAEMON_URL = "http://127.0.0.1:11434"

class ThoughtBox(Static):
    """Renders the AI thinking process with subtle, distinct styling."""
    DEFAULT_CSS = """
    ThoughtBox {
        background: #181924;
        border-left: thick #a855f7;
        padding: 0 1;
        margin-bottom: 1;
        color: #c084fc;
    }
    .thought-title {
        color: #d8b4fe;
        text-style: bold;
    }
    """
    def __init__(self, raw_thought: str = "", **kwargs):
        super().__init__(**kwargs)
        self.raw_thought = raw_thought

    def compose(self) -> ComposeResult:
        yield Label("🧠 Thought Process", classes="thought-title")
        yield Static(RichMarkdown(self.raw_thought) if self.raw_thought else "", id="thought-body")

    def update_thought(self, text: str) -> None:
        self.raw_thought = text
        self.query_one("#thought-body", Static).update(RichMarkdown(self.raw_thought))

class MessageBubble(Static):
    """Renders user or assistant conversation turn synchronously with Rich."""
    DEFAULT_CSS = """
    MessageBubble {
        padding: 1;
        margin-bottom: 1;
        border: solid #272a3a;
        background: #13141f;
    }
    .role-badge {
        width: auto;
        padding: 0 1;
        margin-bottom: 1;
        text-style: bold;
    }
    .role-user {
        background: #1d4ed8;
        color: #ffffff;
    }
    .role-assistant {
        background: #581c87;
        color: #ffffff;
    }
    """
    def __init__(self, role: str, content: str = "", thought: str = "", **kwargs):
        super().__init__(**kwargs)
        self.role = role
        self.raw_content = content
        self.raw_thought = thought

    def compose(self) -> ComposeResult:
        badge_cls = "role-user" if self.role == "user" else "role-assistant"
        yield Label(f" {self.role.upper()} ", classes=f"role-badge {badge_cls}")
        if self.role == "assistant":
            yield ThoughtBox(self.raw_thought, id="thought-container")
        yield Static(RichMarkdown(self.raw_content) if self.raw_content else "", id="content-body")

    def update_content(self, text: str) -> None:
        self.raw_content = text
        self.query_one("#content-body", Static).update(RichMarkdown(self.raw_content))

    def append_thought(self, token: str) -> None:
        self.raw_thought += token
        self.query_one("#thought-container", ThoughtBox).update_thought(self.raw_thought)

class GeminiTUI(App):
    CSS = """
    Screen {
        background: #0d0e15;
        color: #e2e8f0;
    }
    #main-layout {
        height: 1fr;
    }
    #sidebar {
        width: 38;
        background: #161722;
        border-right: heavy #252839;
        padding: 1;
    }
    #chat-pane {
        width: 1fr;
        height: 100%;
        padding: 1 2;
    }
    #messages-scroll {
        height: 1fr;
        scrollbar-gutter: stable;
        padding-bottom: 1;
    }
    #input-dock {
        height: auto;
        min-height: 4;
        border-top: solid #252839;
        padding-top: 1;
    }
    .section-header {
        color: #60a5fa;
        text-style: bold;
        margin-top: 1;
        margin-bottom: 0;
    }
    #chat-list {
        height: 10;
        background: #0d0e15;
        border: solid #252839;
        margin-bottom: 1;
    }
    #mode-indicator {
        background: #2563eb;
        color: #ffffff;
        padding: 0 1;
        text-style: bold;
    }
    #mode-indicator.normal {
        background: #059669;
    }
    #status-lbl {
        color: #10b981;
        margin-bottom: 1;
    }
    #status-lbl.offline {
        color: #ef4444;
    }
    """

    BINDINGS = [
        ("q", "quit_app", "Quit"),
        ("i", "enter_insert_mode", "Insert (Prompt)"),
        ("escape", "exit_to_normal_mode", "Normal Mode"),
        ("j", "scroll_down", "Scroll Down"),
        ("k", "scroll_up", "Scroll Up"),
        ("g", "scroll_top", "Scroll Top"),
        ("G", "scroll_bottom", "Scroll Bottom"),
        ("n", "action_new_chat", "New Chat"),
        ("c", "focus_chats", "Focus Chats"),
        ("m", "focus_models", "Focus Model"),
    ]

    current_chat_id: reactive[str] = reactive("chat-welcome")
    is_insert_mode: reactive[bool] = reactive(False)
    daemon_online: reactive[bool] = reactive(False)
    is_busy: reactive[bool] = reactive(False)

    def compose(self) -> ComposeResult:
        yield Header(show_clock=True)
        with Horizontal(id="main-layout"):
            with Vertical(id="sidebar"):
                with Horizontal():
                    yield Label("-- NORMAL --", id="mode-indicator", classes="normal")
                yield Label("● Daemon Online", id="status-lbl")

                yield Label("ACTIVE CHATS (Press 'c')", classes="section-header")
                yield OptionList(id="chat-list")
                yield Button("+ New Chat (n)", id="btn-new-chat", variant="success")

                yield Label("MODEL (Press 'm')", classes="section-header")
                yield Select([], id="model-select", prompt="Select model...")

                yield Label("SYSTEM INSTRUCTIONS", classes="section-header")
                yield TextArea("You are a helpful Gemini assistant.", id="system-prompt", language="markdown")

            with Vertical(id="chat-pane"):
                with VerticalScroll(id="messages-scroll"):
                    pass
                with Vertical(id="input-dock"):
                    with Horizontal():
                        yield Input(placeholder="Ask anything... (Press 'i' to type, Enter to send)", id="prompt-input")
                        yield Button("Send", id="btn-send", variant="primary")
        yield Footer()

    async def on_mount(self) -> None:
        self.set_poll_timer()
        await self.refresh_daemon_state()

    def set_poll_timer(self) -> None:
        self.set_interval(1.5, self.background_sync_loop)

    # Vim Navigation Actions
    def action_enter_insert_mode(self) -> None:
        self.is_insert_mode = True
        self.query_one("#prompt-input", Input).focus()
        badge = self.query_one("#mode-indicator", Label)
        badge.update("-- INSERT --")
        badge.remove_class("normal")

    def action_exit_to_normal_mode(self) -> None:
        self.is_insert_mode = False
        self.set_focus(None)
        badge = self.query_one("#mode-indicator", Label)
        badge.update("-- NORMAL --")
        badge.add_class("normal")

    def action_scroll_down(self) -> None:
        if not self.is_insert_mode:
            self.query_one("#messages-scroll", VerticalScroll).scroll_relative(y=3)

    def action_scroll_up(self) -> None:
        if not self.is_insert_mode:
            self.query_one("#messages-scroll", VerticalScroll).scroll_relative(y=-3)

    def action_scroll_top(self) -> None:
        if not self.is_insert_mode:
            self.query_one("#messages-scroll", VerticalScroll).scroll_home()

    def action_scroll_bottom(self) -> None:
        if not self.is_insert_mode:
            self.query_one("#messages-scroll", VerticalScroll).scroll_end()

    def action_focus_chats(self) -> None:
        if not self.is_insert_mode:
            self.query_one("#chat-list", OptionList).focus()

    def action_focus_models(self) -> None:
        if not self.is_insert_mode:
            self.query_one("#model-select", Select).focus()

    def action_quit_app(self) -> None:
        if not self.is_insert_mode:
            self.exit()

    @work(exclusive=True)
    async def background_sync_loop(self) -> None:
        if self.is_busy:
            return
        await self.sync_chats_list()
        await self.sync_current_chat()

    async def refresh_daemon_state(self) -> None:
        status_lbl = self.query_one("#status-lbl", Label)
        select_widget = self.query_one("#model-select", Select)
        try:
            async with httpx.AsyncClient(timeout=2.0) as client:
                res = await client.get(f"{DAEMON_URL}/api/tags")
                if res.status_code == 200:
                    models = [m["name"] for m in res.json().get("models", [])]
                    select_widget.set_options([(m, m) for m in models])
                    if models and not select_widget.value:
                        select_widget.value = models[0]
                    self.daemon_online = True
                    status_lbl.update("● Daemon Online (11434)")
                    status_lbl.remove_class("offline")
                    await self.sync_chats_list()
                    await self.load_chat_history(self.current_chat_id)
                    return
        except Exception:
            pass

        self.daemon_online = False
        status_lbl.update("○ Daemon Offline")
        status_lbl.add_class("offline")

    async def sync_chats_list(self) -> None:
        try:
            async with httpx.AsyncClient(timeout=2.0) as client:
                res = await client.get(f"{DAEMON_URL}/api/chats")
                if res.status_code == 200:
                    chats = res.json()
                    chat_opt = self.query_one("#chat-list", OptionList)
                    curr_ids = [opt.id for opt in chat_opt._options]
                    new_ids = [c["id"] for c in chats]

                    if curr_ids != new_ids:
                        chat_opt.clear_options()
                        for c in chats:
                            title = f"[{c['id'][-4:]}] {c['title']} ({c['message_count']})"
                            chat_opt.add_option(Option(prompt=title, id=c["id"]))
        except Exception:
            pass

    async def sync_current_chat(self) -> None:
        try:
            async with httpx.AsyncClient(timeout=2.0) as client:
                res = await client.get(f"{DAEMON_URL}/api/chats/{self.current_chat_id}")
                if res.status_code == 200:
                    chat_data = res.json()
                    msg_count = len(chat_data.get("messages", []))
                    scroll = self.query_one("#messages-scroll", VerticalScroll)
                    existing_rendered = len(scroll.children)
                    if msg_count != existing_rendered:
                        await self.load_chat_history(self.current_chat_id)
        except Exception:
            pass

    async def load_chat_history(self, chat_id: str) -> None:
        try:
            async with httpx.AsyncClient(timeout=2.0) as client:
                res = await client.get(f"{DAEMON_URL}/api/chats/{chat_id}")
                if res.status_code == 200:
                    chat_data = res.json()
                    self.current_chat_id = chat_id
                    scroll = self.query_one("#messages-scroll", VerticalScroll)
                    await scroll.remove_children()

                    for msg in chat_data.get("messages", []):
                        bubble = MessageBubble(
                            role=msg["role"],
                            content=msg["content"],
                            thought=msg.get("thought", ""),
                        )
                        await scroll.mount(bubble)

                    scroll.scroll_end(animate=False)
        except Exception:
            pass

    @on(OptionList.OptionSelected, "#chat-list")
    async def on_select_chat(self, event: OptionList.OptionSelected) -> None:
        if event.option_id:
            await self.load_chat_history(str(event.option_id))
            self.action_exit_to_normal_mode()

    @on(Button.Pressed, "#btn-new-chat")
    def action_new_chat(self) -> None:
        self.create_new_chat_worker()

    @work(exclusive=True)
    async def create_new_chat_worker(self) -> None:
        model = self.query_one("#model-select", Select).value or "gemini-2.5-pro"
        system = self.query_one("#system-prompt", TextArea).text
        try:
            async with httpx.AsyncClient(timeout=3.0) as client:
                res = await client.post(
                    f"{DAEMON_URL}/api/chats",
                    json={"model": model, "title": f"Chat ({model})", "system": system},
                )
                if res.status_code == 200:
                    new_chat = res.json()
                    self.current_chat_id = new_chat["id"]
                    await self.sync_chats_list()
                    await self.load_chat_history(new_chat["id"])
                    self.action_enter_insert_mode()
        except Exception:
            pass

    @on(Button.Pressed, "#btn-send")
    @on(Input.Submitted, "#prompt-input")
    def handle_submit(self) -> None:
        if self.is_busy:
            return

        inp = self.query_one("#prompt-input", Input)
        text = inp.value.strip()
        if not text:
            return

        inp.value = ""
        self.send_and_stream(text)

    @work(exclusive=True)
    async def send_and_stream(self, text: str) -> None:
        self.is_busy = True
        scroll = self.query_one("#messages-scroll", VerticalScroll)

        # Mount user bubble immediately
        user_bubble = MessageBubble("user", text)
        await scroll.mount(user_bubble)

        # Mount assistant placeholder bubble
        assistant_bubble = MessageBubble("assistant", "", "")
        await scroll.mount(assistant_bubble)
        scroll.scroll_end(animate=False)

        model = self.query_one("#model-select", Select).value or "gemini-2.5-pro"
        accumulated_text = ""
        in_thought = False

        try:
            async with httpx.AsyncClient(timeout=60.0) as client:
                async with client.stream(
                    "POST",
                    f"{DAEMON_URL}/api/chat",
                    json={
                        "chat_id": self.current_chat_id,
                        "model": model,
                        "messages": [{"role": "user", "content": text}],
                        "stream": True,
                    },
                ) as resp:
                    if resp.status_code != 200:
                        assistant_bubble.update_content(f"**Error**: HTTP {resp.status_code}")
                        return

                    async for line in resp.aiter_lines():
                        if not line.strip():
                            continue

                        chunk = json.loads(line)
                        token = chunk.get("message", {}).get("content", "")

                        if "<thought>" in token:
                            in_thought = True
                            token = token.replace("<thought>", "")
                        if "</thought>" in token:
                            in_thought = False
                            token = token.replace("</thought>", "")

                        if in_thought:
                            assistant_bubble.append_thought(token)
                        else:
                            accumulated_text += token
                            assistant_bubble.update_content(accumulated_text)

                        scroll.scroll_end(animate=False)

            await self.sync_chats_list()
        except Exception as e:
            assistant_bubble.update_content(f"**Connection Error**: {e}")
        finally:
            self.is_busy = False
            scroll.scroll_end(animate=False)

def main():
    GeminiTUI().run()

if __name__ == "__main__":
    main()
